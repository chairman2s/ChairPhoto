# Maintainer: Andreas Henden <chairman2s.ah+github@gmail.com>

pkgname=chairphoto
pkgver=2026.8.0
pkgrel=1
pkgdesc="Catalog-first photo organizer for large RAW collections"
arch=('x86_64')
url="https://github.com/chairman2s/ChairPhoto"
license=('GPL-3.0-only')

# Every direct library dependency is listed, per the packaging guidelines: several of these
# would also arrive through gtk3 or webkit2gtk-4.1, but relying on a transitive edge breaks
# the moment that intermediate package drops it. Regenerate after changing linked libraries:
#   readelf -d usr/bin/chairphoto | grep NEEDED   ->   pacman -Qoq /usr/lib/<soname>
#
#   libraw          full-resolution RAW decode, linked at build time by the `raw` feature
#   onnxruntime-cpu face detection/recognition and Smart Tagging inference. ort probes for
#                   `libonnxruntime` via pkg-config and links the system library; without it
#                   the build would silently fall back to downloading its own copy, which
#                   build() rejects.
#   hicolor-icon-theme  owns the /usr/share/icons/hicolor directories this package installs into.
#
# librsvg is deliberately absent. Tauri's Linux prerequisites name it, but this package ships
# only PNG icons and nothing links it, so namcap flags it as unneeded. gtk3 depends on it
# regardless, so it remains installed for anything that does want it.
depends=(
  'cairo'
  'dbus'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libgcc'
  'libraw'
  'libsoup3'
  'onnxruntime-cpu'
  'webkit2gtk-4.1'
)

# clang/pkgconf are for the LibRaw bindgen step in src-tauri/build.rs, which reads the
# installed header so the struct ABI matches the linked library exactly.
makedepends=(
  'cargo'
  'clang'
  'nodejs>=24'
  'npm'
  'pkgconf'
)

# Missing runtime tools degrade one feature each; they never crash the app.
optdepends=(
  'perl-image-exiftool: EXIF/IPTC/XMP extraction and RAW preview fallback'
  'exiv2: primary embedded-preview extractor for RAW thumbnails'
  'ffmpeg: video poster frames and slideshow .mp4 rendering'
  'imagemagick: HEIF/HEIC (iPhone) decoding'
  'libheif: HEIF/HEIC delegate for ImageMagick'
  'chromium: posting exports to Instagram'
)

# makepkg enables LTO globally, which breaks this build. libsqlite3-sys (bundled SQLite) and
# ring compile C/assembly through the `cc` crate, so they inherit -flto=auto and emit bitcode,
# but rustc links with -fuse-ld=lld and no -flto and never runs the LTO codegen step. The
# result is undefined sqlite3_* and ring_core_* symbols at link time. Pure-Rust dependencies
# are unaffected, which is why only these two show up.
options=(!lto)

source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        "$pkgname.desktop")
# Regenerate with `updpkgsums` after every pkgver bump; see README.md in this directory.
sha256sums=('9243bce8e428bf534228c598f0b5e78cb932684adf4fa91965d583bd1ebb2ebf'
            'f886deeefb89b0ac96497bf02e6307539175fbb99a498ba3f40ed8ff14e10f00')

prepare() {
  cd "ChairPhoto-$pkgver"

  # Both fetches need network, and are kept here so build() can run entirely offline.
  # --locked pins the Cargo.lock versions; --target limits the fetch to this host.
  export RUSTUP_TOOLCHAIN=stable
  npm ci
  cargo fetch --locked --manifest-path src-tauri/Cargo.toml \
    --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "ChairPhoto-$pkgver"

  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # Equivalent to cargo's --frozen, which cannot be passed through the Tauri CLI: the build
  # may only use what prepare() already fetched, so dependency resolution cannot drift.
  export CARGO_NET_OFFLINE=true

  # ort tries pkg-config before its download path and *silently* falls back to fetching a
  # prebuilt ONNX Runtime when the probe fails, which would make this package build depend on
  # a network blob instead of the onnxruntime-cpu dependency. It also ignores a system library
  # older than the API level it wants (24), so check the version the same way ort does.
  local _ort_minor
  if ! _ort_minor=$(pkg-config --modversion libonnxruntime 2>/dev/null); then
    echo "==> ERROR: pkg-config cannot find libonnxruntime; is onnxruntime-cpu installed?" >&2
    return 1
  fi
  _ort_minor=$(echo "$_ort_minor" | cut -d. -f2)
  if (( _ort_minor < 24 )); then
    echo "==> ERROR: onnxruntime 1.$_ort_minor is older than the API level ort requires (24)." >&2
    echo "    ort would ignore it and download its own copy instead." >&2
    return 1
  fi

  # Upstream defaults: ai, edit, raw, instagram, collage, slideshow, localsend, map, faces,
  # smarttags — plus flickr and smugmug, which are opt-in upstream but shipped here.
  #
  # Their Rust backends are compiled in (docs/plugin-system.md: no hot-loading), so a user
  # cannot add them later without rebuilding, and splitting them into their own package would
  # mean a second conflicting build of the same binary. Enabling them costs one pure-Rust
  # crate (hmac) and no new system libraries — `cargo tree` adds no -sys crates — so depends
  # is unaffected and the only price is a slightly larger binary.
  #
  # --no-bundle stops Tauri from also producing deb/rpm/AppImage images we would discard.
  npm run tauri build -- --no-bundle --features flickr,smugmug
}

check() {
  cd "ChairPhoto-$pkgver"

  # The probe in build() is a precondition, not proof. ort only *prefers* pkg-config: if the
  # `pkg-config` feature is missing from src-tauri/Cargo.toml, or the probe fails inside the
  # build script for any reason, ort quietly downloads its own runtime and the build still
  # succeeds — producing a package that ignores the onnxruntime-cpu dependency it declares.
  # Assert the outcome instead of trusting it.
  local _linked='libonnxruntime\.so[^ ]* => /usr/lib/'
  if ! ldd "src-tauri/target/release/$pkgname" | grep -qE "$_linked"; then
    echo "==> ERROR: the binary does not link the system libonnxruntime." >&2
    echo "    ort most likely downloaded its own runtime. Check that the ort dependency in" >&2
    echo "    src-tauri/Cargo.toml still enables the \`pkg-config\` feature." >&2
    return 1
  fi
}

package() {
  cd "ChairPhoto-$pkgver"

  install -Dm755 "src-tauri/target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 "$srcdir/$pkgname.desktop" "$pkgdir/usr/share/applications/$pkgname.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  install -Dm644 "src-tauri/icons/32x32.png" \
    "$pkgdir/usr/share/icons/hicolor/32x32/apps/$pkgname.png"
  install -Dm644 "src-tauri/icons/128x128.png" \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/$pkgname.png"
  install -Dm644 "src-tauri/icons/128x128@2x.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/$pkgname.png"
  install -Dm644 "src-tauri/icons/icon.png" \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/$pkgname.png"
}
