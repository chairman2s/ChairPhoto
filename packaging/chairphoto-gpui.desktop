[Desktop Entry]
Type=Application
Name=ChairPhoto (GPUI preview)
GenericName=Photo Organizer
Comment=Catalog-first photo organizer for large RAW collections — native GPUI front end
# %u passes a chairphoto:// URL. A second launch hands it to the running instance over
# its single-instance socket (crates/app/src/single_instance.rs) and exits.
Exec=chairphoto-gpui %u
Icon=chairphoto
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;Photography;Viewer;
# Registers the chairphoto:// scheme for the GPUI binary. Not installed by PKGBUILD yet:
# until the cutover (map #92, Phase 6) the Tauri app's chairphoto.desktop owns the scheme,
# and the cutover renames the binary to chairphoto and folds this entry into that one.
MimeType=x-scheme-handler/chairphoto;
StartupNotify=true
StartupWMClass=chairphoto
Keywords=photo;photography;raw;catalog;organizer;culling;xmp;
