[Desktop Entry]
Type=Application
Name=ChairPhoto
GenericName=Photo Organizer
Comment=Catalog-first photo organizer for large RAW collections
# %u passes a chairphoto:// URL through to the running instance. A second launch hands it to
# the running one over its single-instance socket (crates/app/src/single_instance.rs) and
# exits, rather than starting a second copy.
Exec=chairphoto %u
Icon=chairphoto
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;Photography;Viewer;
# Registers the chairphoto:// scheme (crates/app/src/desktop.rs) so
# links from Obsidian and other apps open the catalog at the right photo or tag.
MimeType=x-scheme-handler/chairphoto;
StartupNotify=true
StartupWMClass=chairphoto
Keywords=photo;photography;raw;catalog;organizer;culling;xmp;
