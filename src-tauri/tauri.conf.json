{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chairphoto",
  "version": "2026.8.0",
  "identifier": "com.chairman.chairphoto",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ChairPhoto",
        "width": 1400,
        "height": 900,
        "dragDropEnabled": false,
        "backgroundColor": "#0F172A"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self' asset: http://asset.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: asset: thumb: preview: zoom: http://asset.localhost http://thumb.localhost http://preview.localhost http://zoom.localhost https: http://127.0.0.1:* http://localhost:*",
        "media-src": "'self' data: blob: http://127.0.0.1:* http://localhost:*",
        "font-src": "'self' data:",
        "object-src": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["$DATA/chairphoto/modules/**"]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["chairphoto"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
